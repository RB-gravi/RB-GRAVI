# Feature Flags
# Set to "true" to enable; defaults to "false" when unset.

# Enables the "new feature" UI enhancements.
FEATURE_ENABLE_NEW_FEATURE=false

# Enables security hardening: applies strict HTTP security headers
# (Content-Security-Policy, X-Frame-Options, Strict-Transport-Security, etc.)
# to every response.  Off by default; enable in production for hardened deployments.
FEATURE_ENABLE_SECURITY_HARDENING=false
